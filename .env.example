# The repository the factory works on. Must be an existing GitHub repository
# in owner/repo format, and the GitHub App (GITHUB_* below) must be installed
# with access to it: a station sandbox clones this repository on its first
# session and fails with "Cannot access <owner/repo>" when the app cannot
# reach it. A missing or malformed value fails discovery with a clear error.
FACTORY_REPO=acme/widgets

# GitHub auth: the self-held GitHub App (agent/lib/github/credentials.ts).
# The App JWT is signed from the private key and a 1h installation token is
# minted per call; none of this is ever exposed to the model.
GITHUB_APP_ID=123456
GITHUB_INSTALLATION_ID=42
# The App's PEM private key: point to a file (preferred), or paste inline.
# GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/app-private-key.pem
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# The App's slug; the @mention name resolves from it (FACTORY_BOT_NAME
# overrides). Dispatch refuses events until this (or the override) is set.
GITHUB_APP_SLUG=my-foreman
# Verifies inbound webhook signatures; must match the secret configured on
# the GitHub App's webhook settings.
GITHUB_WEBHOOK_SECRET=change_me

# Model provider (agent/lib/models.ts): Zhipu GLM via the Anthropic-compatible
# endpoint.
ZHIPU_API_KEY=sk-xxxx
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/anthropic/v1

# Route auth for the eve HTTP API (/eve/v1/*, agent/channels/eve.ts): Basic
# credentials the remote TUI and every HTTP client must present. Required;
# production fails closed without them.
ROUTE_AUTH_BASIC_USERNAME=foreman
ROUTE_AUTH_BASIC_PASSWORD=change_me

# Self-hosted form: switch both backends off Vercel (cloud form keeps the
# defaults). See docs/自托管实施方案.md for the full setup.
# FACTORY_SANDBOX_BACKEND=docker    # Docker station sandboxes (default vercel)
# FACTORY_BLOB_BACKEND=local        # filesystem Blob store (default vercel)
# FACTORY_DATA_DIR=.eve/blob-data   # root for the local Blob backend

# Optional behavior; every one has a sensible default.
# FACTORY_SETUP_COMMAND="pnpm install"  # runs inside the station clone once per session
# FACTORY_LABEL="factory"               # the label that hands an issue to the factory
# FACTORY_BRANCH_PREFIX="factory/"      # branch prefix marking the factory's own PRs
# FACTORY_BOT_NAME=""                   # @mention name override; defaults to GITHUB_APP_SLUG
